{
  "datasets": [
    {
      "name": "9626de56",
      "displayName": "Live kpis",
      "queryLines": [
        "select \r\n",
        "total_revenue_inr,\r\n",
        "cancellation_rate_pct,\r\n",
        "active_drivers,\r\n",
        "avg_fare_inr,\r\n",
        "CAST(ROUND(total_rides * (100 - cancellation_rate_pct) / 100,0) AS BIGINT) as completed_rides\r\n",
        " from workspace.realtime.gold_live_kpis"
      ],
      "catalog": "workspace",
      "schema": "realtime"
    },
    {
      "name": "69c75b48",
      "displayName": "Revenue per Minute",
      "queryLines": [
        "select \r\n",
        "minute_bucket,\r\n",
        "revenue_inr,\r\n",
        "completed_rides\r\n",
        "from workspace.realtime.gold_revenue_per_minute"
      ]
    },
    {
      "name": "a75d287f",
      "displayName": "Untitled dataset",
      "queryLines": [
        "select status , CAST(ride_count AS BIGINT) AS ride_count FROM workspace.realtime.gold_ride_status_breakdown ORDER BY ride_count DESC"
      ]
    },
    {
      "name": "822c56a2",
      "displayName": "City Performances",
      "queryLines": [
        "Select city, ROUND(revenue_inr,0) AS revenue_inr FROM workspace.realtime.gold_rides_by_city ORDER BY revenue_inr DESC"
      ]
    },
    {
      "name": "31d75ab9",
      "displayName": "Top Revenue Zones",
      "queryLines": [
        "select zone_id,city,ROUND(total_revenue_inr,0) AS tatal_revenue_inr,CAST(completed_rides AS BIGINT) AS completed_rides,ROUND(avg_fare_inr,0) AS avg_fare_inr\r\n",
        "from workspace.realtime.gold_top_zones ORDER BY total_revenue_inr DESC LIMIT 10"
      ]
    },
    {
      "name": "45b4d911",
      "displayName": "Cancellation Reasons",
      "queryLines": [
        "select city,coalesce(nullif(cancellation_reason,''), status) as reason,cancellation_count from workspace.realtime.gold_cancellation_analysis Group By city,coalesce(nullif(cancellation_reason,''),status),cancellation_count ORDER BY cancellation_count DESC"
      ]
    }
  ],
